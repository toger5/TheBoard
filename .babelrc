{
    "presets": [
        "@babel/preset-env",
        [
            "@babel/preset-react",
            {
                "runtime": "classic",
                "pragma": "jsxElem.createElement",
                "pragmaFrag": "jsxElem.Fragment"
            }
        ]
    ],
    "plugins": [
        [
            "@babel/plugin-transform-for-of",
            {
                "allowArrayLike": true
            }
        ],
        [
            "babel-plugin-polyfill-corejs3",
            {
                "method": "usage-global",
                "version": "3.51"
            }
        ]
    ]
}
