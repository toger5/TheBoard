{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": false,
        "strict": false,
        "module": "esnext",
        "target": "es2020",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    }
}
